pub fn encode_tombstone(name: Str) -> Bytes []
    todo("nvfs-core.nvfsvol.encode_tombstone")

// A rename's record payload: both names, in one record.
//
// ```novo
// use std.bytes
// use nvfsvol
//
// fn main() [io]
//     println("${bytes.len(nvfsvol.encode_rename("boot", "boot.old"))}")
