// nvfsvol.nv — what a record MEANS: the superblock, the directory
// entries, and the fold that turns a log into a directory.
//
// Every body here is a `todo()`; the signatures are the design.
//
// NOT IN THE DEVICE CLAIM.  An entry holds a name and, for a small
// file, its contents; a fold answers a list of them.  Both allocate.
//
// FIVE RECORD TYPES, AND 0xFF IS RESERVED FOREVER:
//
//     0x01 superblock   magic, version, geometry, the bounds
//     0x02 entry        kind, name, and two kind-dependent words
//     0x03 tombstone    a name that is gone
//     0x04 rename       an old name and a new one, in ONE record
//     0xFF reserved     what erased flash reads as
//
// THE RENAME IS ONE RECORD AND THAT IS THE WHOLE ARGUMENT FOR IT.  A
// rename written as a tombstone plus an entry is two commits, and a
// power cut between them loses the file — the name it had is gone and
// the name it was getting never arrived.  One record makes it atomic
// for free, and it is why a cross-directory move is `NvfsNotSupported`
// rather than done unsafely: that one would be two records in two
// different pairs, which this format cannot commit together.
//
// A DIRECTORY'S LIVE STATE IS A FOLD OVER ITS LOG, in order: an entry
// record upserts by name, a tombstone removes, a rename moves.  So
// reading a directory is reading one block and folding, and there is no
// index to keep consistent across a power cut.
//
// THE ROOT IS THE SUPERBLOCK PAIR.  Blocks 0 and 1 hold both, exactly
// as littlefs does, which is why the root never relocates and why a
// compaction of the root has to preserve a superblock record that no
// other directory has.

use nvfsgeo
use nvfsmeta

// The device this volume is formatted for.
//
// A plain struct rather than a `@value` one: it is a host-side
// description that travels inside `NvfsVolume`, and a `@value` type
// cannot be a boxed struct's field.  The device half of this package
// takes these four as separate `Int`s for exactly that reason, which
// is `nvfsgeo`'s whole signature style.
pub struct NvfsGeometry
    read_size: Int
    prog_size: Int
    block_size: Int
    block_count: Int

// The choices a format makes, which the superblock then carries.
pub struct NvfsConfig
    // Compactions before a metadata pair moves to fresh blocks; -1
    // disables relocation.
    block_cycles: Int
    // The largest filename this volume accepts.  On disk contract, not
    // a suggestion: a name longer than this cannot be written back by
    // a reader that respects the superblock.
    name_max: Int
    // The largest file.
    file_max: Int
    // At or below this, a file's contents live in its directory entry
    // and cost no data block at all.
    inline_max: Int

// What a mount found.
pub struct NvfsVolume
    geometry: NvfsGeometry
    superblock: NvfsSuperblock
    // The winning revision at mount time, which is also what seeds the
    // allocation cursor.
    revision: Int
    // Which block of the root pair won: 0 or 1.
    active: Int

// The superblock record's contents.
//
// The geometry is stored as well as detected, because a mismatch is
// the one failure a filesystem must refuse rather than work around: an
// image built for 4 KiB blocks read as 64 KiB ones would find records
// at plausible offsets and answer nonsense.
pub struct NvfsSuperblock
    version: Int
    block_size: Int
    block_count: Int
    name_max: Int
    inline_max: Int
    file_max: Int
    block_cycles: Int

// What a directory entry names.
pub enum NvfsEntryKind
    // A subdirectory: the two words are its metadata pair.
    NvfsKindDirectory
    // A small file: the contents are in the record and the two words
    // are unused.
    NvfsKindInline
    // A larger file: the two words are the head block of its CTZ chain
    // and its size in bytes.
    NvfsKindChain

// One entry of a directory.
pub struct NvfsEntry
    name: Str
    kind: NvfsEntryKind
    // Kind-dependent: a directory's pair blocks, or a chain's head and
    // size.  Named for what they are on disk rather than for one of
    // their three meanings, because a field called `head` would be
    // wrong for two thirds of the entries.
    word_first: Int
    word_second: Int
    // An inline file's contents, and empty for every other kind.
    inline_data: Bytes

// The configuration a format uses when the caller does not say.
//
// ```novo
// use nvfsvol
//
// fn main() [io]
//     println("${nvfsvol.default_config().inline_max}")
// ```
pub fn default_config() -> NvfsConfig []
    todo("nvfs-core.nvfsvol.default_config")

// A geometry.
//
// A constructor rather than a struct literal, and every struct this
// module exposes carries one: a struct declared in one module cannot be
// built with a qualified literal from another, so
// `nvfsvol.NvfsGeometry { … }` in a caller is a parse error.
//
// ```novo
// use nvfsvol
//
// fn main() [io]
//     println("${nvfsvol.geometry(16, 16, 512, 32).block_count}")
// ```
pub fn geometry(read_size: Int, prog_size: Int, block_size: Int,
                block_count: Int) -> NvfsGeometry []
    todo("nvfs-core.nvfsvol.geometry")

// A configuration.
//
// ```novo
// use nvfsvol
//
// fn main() [io]
//     println("${nvfsvol.config(100, 64, 4096, 128).inline_max}")
// ```
pub fn config(block_cycles: Int, name_max: Int, file_max: Int, inline_max: Int) -> NvfsConfig []
    todo("nvfs-core.nvfsvol.config")

// A superblock, for a caller building one rather than reading one.
//
// ```novo
// use nvfsvol
//
// fn main() [io]
//     println("${nvfsvol.superblock(65536, 512, 32, 64, 128, 4096, 100).block_size}")
// ```
pub fn superblock(version: Int, block_size: Int, block_count: Int, name_max: Int, inline_max: Int,
                  file_max: Int, block_cycles: Int) -> NvfsSuperblock []
    todo("nvfs-core.nvfsvol.superblock")

// A volume, for a caller holding the four facts a mount answered.
//
// ```novo
// use nvfsvol
//
// fn main() [io]
//     let g = nvfsvol.geometry(16, 16, 512, 32)
//     let sb = nvfsvol.superblock(65536, 512, 32, 64, 128, 4096, 100)
//     println("${nvfsvol.volume(g, sb, 1, 0).revision}")
// ```
pub fn volume(g: NvfsGeometry, sb: NvfsSuperblock, revision: Int, active: Int) -> NvfsVolume []
    todo("nvfs-core.nvfsvol.volume")

// Whether a configuration fits a geometry, and which error to answer
// when it does not.
//
// `NvfsOk` for a usable pair.  The rules are littlefs's: a name bound
// between 1 and 255 because it is a byte on disk, an inline threshold
// no larger than a record may be, a positive file bound, and a
// relocation threshold that is not zero.
//
// ```novo
// use nvfsgeo
// use nvfsvol
//
// fn main() [io]
//     let g = nvfsvol.geometry(16, 16, 512, 32)
//     println(nvfsgeo.error_name(nvfsvol.check_config(nvfsvol.default_config(), g)))
// ```
pub fn check_config(c: NvfsConfig, g: NvfsGeometry) -> nvfsgeo.NvfsError []
    todo("nvfs-core.nvfsvol.check_config")

