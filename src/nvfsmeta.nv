// nvfsmeta.nv — a metadata pair: the append-only record log, its
// arbitration, and the commit-and-seal cycle.
//
// NOT IN THE DEVICE CLAIM.  A record holds `Bytes` and a scan answers a
// list of them, so this module allocates by construction.  The
// arithmetic it decides with is `nvfsgeo`'s and IS in the claim; a
// firmware that wants to append a record without a heap builds the
// image itself with `nvfsgeo.record_span` and `record_crc`, and a
// firmware with a heap uses this.
//
// A PAIR IS TWO ERASE BLOCKS AND ONE LOG.  The block with the higher
// SEALED revision is active; the other is the spare a compaction folds
// into.  That is the whole of littlefs's crash resistance and it is
// four rules:
//
//   * every mutation is exactly ONE self-CRC'd record, so per-record
//     atomicity is the entire story — a rename is one record, not a
//     tombstone and a dirent;
//   * a record whose CRC does not match ENDS the valid log and marks
//     the block full, because NOR programming only clears bits and the
//     garbage tail cannot be rewritten;
//   * a compaction programs every record and seals the revision word
//     LAST, on its own prog page, so a cut before the seal is
//     invisible and a cut after it leaves a block complete by
//     construction;
//   * when an append does not fit, the new record RIDES INSIDE the
//     compaction — one seal covers both — which is what keeps the
//     one-record atomicity story true even when the block was full.
//
// THIS MODULE IS DOMAIN-FREE.  What a record MEANS — superblock,
// directory entry, tombstone, rename — is `nvfsvol`'s business.  The
// fold that must survive a compaction is computed by the caller and
// handed back in as a plain record list, which is what lets the same
// log machinery carry the root directory and a subdirectory with no
// branch between them.
//
// SCANNING TAKES THE BLOCK'S BYTES, WHICH IS THE SANS-IO SHAPE.  The
// host read the block; this decodes it.  `scan` never asks for
// anything, so a test scans a byte array it built by hand and a
// power-cut test scans one it truncated.

use crc
use nvfsgeo
use nvfswear

// One record: a type byte and a payload.
//
// The CRC is not a field because it is computed over the encoded form
// and checked when the block is scanned; a record in memory that
// carried one would let the two disagree.
pub struct NvfsRecord
    rtype: Int
    payload: Bytes

// What one block's bytes decoded to.
pub struct NvfsScan
    // Whether the revision word is sealed, which is whether this block
    // takes part in arbitration at all.
    valid: Bool
    revision: Int
    // The records in log order.  A fold over these in order is the
    // block's live state.
    records: [NvfsRecord]
    // Whether the log ended in garbage.  A torn block is FULL: the
    // next commit must compact to the sibling.
    torn: Bool
    // The first free byte an append may start at, aligned to a prog
    // page.  The block size when torn, which is how `append_allowed`
    // refuses without a second flag.
    end_offset: Int

// The two blocks a directory lives in.
pub struct NvfsPair
    first: Int
    second: Int

// Which of a pair won, and what it holds.
pub struct NvfsPairState
    // False when neither block is valid: a fresh device, or wreckage.
    // The two are told apart by whether either block was torn, which
    // is why `scan` reports that separately.
    ok: Bool
    active: Int
    sibling: Int
    scan: NvfsScan

// Build a record.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     let r = nvfsmeta.record(2, bytes.from_byte_list([1, 2]))
//     println("${nvfsmeta.record_type(r)}")
// ```
pub @tier(app)
fn record(rtype: Int, payload: Bytes) -> NvfsRecord []
    NvfsRecord { rtype: rtype, payload: payload }

// A record's type byte.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     println("${nvfsmeta.record_type(nvfsmeta.record(2, bytes.from_byte_list([])))}")
// ```
pub @tier(app)
fn record_type(r: NvfsRecord) -> Int []
    r.rtype

// A record's payload.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     println("${bytes.len(nvfsmeta.record_payload(nvfsmeta.record(2, bytes.from_byte_list([1]))))}")
// ```
pub @tier(app)
fn record_payload(r: NvfsRecord) -> Bytes []
    // A copy: the interface answers a buffer the caller may write,
    // and the record's own payload is not the caller's to write.
    bytes.clone(r.payload)

// The bytes a record occupies on disk: header, payload, CRC.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     println("${bytes.len(nvfsmeta.encode_record(nvfsmeta.record(2, bytes.from_byte_list([1]))))}")
// ```
pub @tier(app)
fn encode_record(r: NvfsRecord) -> Bytes []
    // [ type u8 | flags u8 | len u16 | payload | crc32c u32 ], all
    // little-endian, and the CRC covers the header AND the payload and
    // NOT its own four bytes — a checksum that covered itself could
    // never be checked, because the bytes it would check do not exist
    // until it has been computed.
    //
    // The flags byte is reserved and written as zero.  It is written
    // by this function and read by `scan_block` through the same
    // layout, so it is where a future flag goes rather than spare
    // room to spend.
    let header = bytes.u8(r.rtype) + bytes.u8(0) + bytes.u16_le(bytes.len(r.payload))
    let body = header + r.payload
    let sum = record_crc(body)
    body + bytes.u32_le(sum)

// The CRC-32C of a record's header and payload, which is what the
// four bytes after them hold.
//
// crc-nv's, and published here rather than left implicit because a
// driver building a record image itself — a firmware with no heap —
// needs the same number this package would have computed.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     println("${nvfsmeta.record_crc(bytes.from_str("123456789"))}")
// ```
pub @tier(app)
fn record_crc(header_and_payload: Bytes) -> Int []
    // `crc-nv`'s published check value says this is CRC-32C: the nine
    // bytes `123456789` answer 0xE3069283, and the suite asserts it.
    // The table is built per call, which a caller checksumming a
    // stream should not pay — `checksum` is the one to hold.
    crc.crc32c().checksum(header_and_payload)

// The CRC-32C algorithm this format uses.
//
// Published so a caller checksumming a stream of records as it builds
// them holds one `Crc` rather than building the table per record.
//
// ```novo
// use nvfsmeta
//
// fn main() [io]
//     println("${nvfsmeta.checksum().width}")
// ```
pub @tier(app)
fn checksum() -> crc.Crc []
    crc.crc32c()

// Decode a whole metadata block from the bytes the host read.
//
// The sans-IO boundary: the host performed the read, this decides what
// it means.  Every power-loss case is reachable from here with a byte
// array — a truncated record, a record whose CRC does not match, a
// block whose revision word is still erased — which is why the torture
// harness `orbit/novofs` built around a fault-injecting device becomes,
// here, a table of byte arrays.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     let s = nvfsmeta.scan_block(256, 4096, bytes.zeros(4096))
//     println("${nvfsmeta.scan_valid(s)}")
// ```
pub @tier(app)
fn scan_block(prog_size: Int, block_size: Int, image: Bytes) -> NvfsScan []
    // A block is untrusted input: every offset this walks to has been
    // checked against the image and the block before it is used, and
    // nothing is sliced out of a header whose length field says it
    // reaches past the end.
    let algo = crc.crc32c()
    let word = bytes.u32_le_at(image, 0) ?? nvfsgeo.erased_word()
    let valid = nvfswear.revision_is_sealed(word)
    // A host that answered a short read hands in a short image, and
    // the walk may not step past the bytes it actually got.
    var limit = block_size
    if bytes.len(image) < limit
        limit = bytes.len(image)
    var records: [NvfsRecord] = []
    var torn = false
    var off = nvfsgeo.meta_offset(prog_size)
    var end = off
    var running = true
    while running and off < limit
        let rtype = bytes.byte_at(image, off) ?? nvfsgeo.erased_byte()
        if rtype == nvfsgeo.reserved_record_type()
            // Free space: the log ended here, and an append starts
            // here.  The padding BETWEEN records is never read — the
            // walk reaches the next record by `align_up`, which is how
            // the erased runs an append leaves are stepped over rather
            // than mistaken for the end.
            running = false
        else
            let len = bytes.u16_le_at(image, off + 2) ?? 0
            let body_end = off + 4 + len
            if body_end + 4 > limit
                // The length field says the record reaches past what
                // the host read.  Nothing is sliced; the log ends here
                // and the block is full.
                torn = true
                end = block_size
                running = false
            else
                let body = bytes.slice(image, off, body_end)
                let stored = bytes.u32_le_at(image, body_end) ?? 0
                if algo.checksum(body) != stored
                    // One bit anywhere in the header or the payload —
                    // or in the CRC field itself — lands here.  Rule 2:
                    // the log ends and the block is FULL, because NOR
                    // programming only clears bits and this tail cannot
                    // be rewritten.
                    torn = true
                    end = block_size
                    running = false
                else
                    records = list.push(records, record(rtype, bytes.slice(image, off + 4, body_end)))
                    end = nvfsgeo.align_up(body_end + 4, prog_size)
                    off = end
    // An unsealed block still reports the records it holds — a
    // compaction interrupted between its last record and its seal
    // leaves exactly that — and `valid` is what keeps it out of
    // arbitration.
    var revision = 0
    if valid
        revision = word
    NvfsScan { valid: valid,
               revision: revision,
               records: records,
               torn: torn,
               end_offset: end }

// Whether a scanned block takes part in arbitration.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     println("${nvfsmeta.scan_valid(nvfsmeta.scan_block(256, 4096, bytes.zeros(4096)))}")
// ```
pub @tier(app)
fn scan_valid(s: NvfsScan) -> Bool []
    s.valid

// A scanned block's revision.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     println("${nvfsmeta.scan_revision(nvfsmeta.scan_block(256, 4096, bytes.zeros(4096)))}")
// ```
pub @tier(app)
fn scan_revision(s: NvfsScan) -> Int []
    s.revision

// A scanned block's records, in log order.
//
// ```novo
// use std.bytes
// use std.list
// use nvfsmeta
//
// fn main() [io]
//     println("${list.len(nvfsmeta.scan_records(nvfsmeta.scan_block(256, 4096, bytes.zeros(4096))))}")
// ```
pub @tier(app)
fn scan_records(s: NvfsScan) -> [NvfsRecord] []
    // A copy of the list, for the same reason: a caller that pushed
    // into what this answered would be editing the scan.
    s.records[:]

// Whether a scanned block's log ended in garbage.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     println("${nvfsmeta.scan_torn(nvfsmeta.scan_block(256, 4096, bytes.zeros(4096)))}")
// ```
pub @tier(app)
fn scan_torn(s: NvfsScan) -> Bool []
    s.torn

// The first byte an append to this block may start at.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     println("${nvfsmeta.scan_end(nvfsmeta.scan_block(256, 4096, bytes.zeros(4096)))}")
// ```
pub @tier(app)
fn scan_end(s: NvfsScan) -> Int []
    s.end_offset

// A pair, by its two block numbers.
//
// ```novo
// use nvfsmeta
//
// fn main() [io]
//     println("${nvfsmeta.pair(0, 1).first}")
// ```
pub @tier(app)
fn pair(first: Int, second: Int) -> NvfsPair []
    NvfsPair { first: first, second: second }

// Which block of a pair is active, given both scans.
//
// `nvfswear.winner` is the rule; this is that rule applied to two
// scans, so a caller with the bytes never has to unpack them.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     let s = nvfsmeta.scan_block(256, 4096, bytes.zeros(4096))
//     println("${nvfsmeta.arbitrate(nvfsmeta.pair(0, 1), s, s).ok}")
// ```
pub @tier(app)
fn arbitrate(p: NvfsPair, first: NvfsScan, second: NvfsScan) -> NvfsPairState []
    let w = nvfswear.winner(first.revision, first.valid, second.revision, second.valid)
    if w == 1
        NvfsPairState { ok: true, active: p.second, sibling: p.first, scan: second }
    elif w == 0
        NvfsPairState { ok: true, active: p.first, sibling: p.second, scan: first }
    else
        // Neither takes part.  A fresh device and wreckage both land
        // here, and `pair_is_blank` is what tells them apart; the
        // first block is named as the pair's own so a caller that
        // asks anyway answers a block of the pair rather than zero.
        NvfsPairState { ok: false, active: p.first, sibling: p.second, scan: first }

// Whether neither block held anything at all — a fresh device rather
// than a damaged volume.
//
// The distinction `mount` turns on: neither block valid AND neither
// torn is `NvfsNoFilesystem`; neither valid and one torn is
// `NvfsCorrupt`.  A driver that conflated them would reformat a volume
// whose superblock was recoverable.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     let s = nvfsmeta.scan_block(256, 4096, bytes.zeros(4096))
//     println("${nvfsmeta.pair_is_blank(s, s)}")
// ```
pub @tier(app)
fn pair_is_blank(first: NvfsScan, second: NvfsScan) -> Bool []
    // Not-valid is not enough on its own: a block can be unsealed
    // BECAUSE a compaction was cut in the middle of it, and that is
    // damage rather than a blank part.
    not first.valid
        and not second.valid
        and not first.torn
        and not second.torn

// The image an append programs: the record, padded to a prog page with
// the erased byte.
//
// Padded with `0xFF` so the padding is indistinguishable from free
// space on the next scan, which is why the scanner steps over runs of
// it rather than stopping at the first one.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     let r = nvfsmeta.record(2, bytes.from_byte_list([1]))
//     println("${bytes.len(nvfsmeta.append_image(r, 16))}")
// ```
pub @tier(app)
fn append_image(r: NvfsRecord, prog_size: Int) -> Bytes []
    let encoded = encode_record(r)
    pad_to(encoded, prog_size)

// The image a compaction programs: every record, each padded to a prog
// page, with NO revision word.
//
// The revision word is programmed separately and last, which is why it
// is not in this image.  Two calls rather than one because the gap
// between them is the power-loss window the format is built around,
// and an API that wrote both at once would have removed the property.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     println("${bytes.len(nvfsmeta.compaction_image([], 16))}")
// ```
pub @tier(app)
fn compaction_image(records: [NvfsRecord], prog_size: Int) -> Bytes []
    // One image rather than one call per record, so the driver
    // programs the whole compaction as a single operation and the
    // seal that follows it is the only thing left to cut.
    var out = bytes.zeros(0)
    for r in records
        let encoded = encode_record(r)
        out = out + pad_to(encoded, prog_size)
    out

// The image the seal programs: the revision word, padded to a prog
// page.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     println("${bytes.len(nvfsmeta.seal_image(1, 16))}")
// ```
pub @tier(app)
fn seal_image(revision: Int, prog_size: Int) -> Bytes []
    let word = bytes.u32_le(revision)
    pad_to(word, prog_size)

// How many bytes a record set occupies as a compaction lays it out.
//
// The pre-check that turns a doomed compaction into `NvfsNoSpace`
// before anything is erased — which matters, because the erase is the
// step that destroys the sibling's old contents.
//
// ```novo
// use nvfsmeta
//
// fn main() [io]
//     println("${nvfsmeta.records_span([], 16)}")
// ```
pub @tier(app)
fn records_span(records: [NvfsRecord], prog_size: Int) -> Int []
    // Summed through `nvfsgeo.record_span`, which is the same
    // arithmetic `pad_to` performs on the image: one spelling of the
    // padding, so a span and an image of that span cannot disagree.
    var span = 0
    for r in records
        span = span + nvfsgeo.record_span(bytes.len(r.payload), prog_size)
    span

// Whether a record set fits one block after compaction.
//
// ```novo
// use nvfsmeta
//
// fn main() [io]
//     println("${nvfsmeta.compaction_fits([], 16, 4096)}")
// ```
pub @tier(app)
fn compaction_fits(records: [NvfsRecord], prog_size: Int, block_size: Int) -> Bool []
    // The records do not start at zero: the revision word's own page
    // is in front of them, and a compaction that forgot that would
    // erase the sibling and then fail to fit.
    nvfsgeo.meta_offset(prog_size) + records_span(records, prog_size) <= block_size

// Pad an image out to a prog-page multiple with the erased byte.
//
// ```novo
// use std.bytes
// use nvfsmeta
//
// fn main() [io]
//     println("${bytes.len(nvfsmeta.pad_to(bytes.zeros(3), 16))}")
// ```
pub @tier(app)
fn pad_to(image: Bytes, prog_size: Int) -> Bytes []
    // The erased byte, because the padding IS free space to the next
    // scan — a zero here would read as a record with type zero.
    let n = bytes.len(image)
    let target = nvfsgeo.align_up(n, prog_size)
    let pad = target - n
    if pad <= 0
        // Already a whole number of pages: the interface answers a
        // buffer the caller may write, so it answers a copy rather
        // than the one it was handed.
        bytes.clone(image)
    else
        image + bytes.fill(bytes.zeros(pad), 0, pad, nvfsgeo.erased_byte())
